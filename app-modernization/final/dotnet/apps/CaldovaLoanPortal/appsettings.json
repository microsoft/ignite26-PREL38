  "AuthGatewayLoginUrl": "",
  "AuthGatewayLogoutUrl": "",
  "PUBLIC_BASE_URL": "",
  "LoanOriginationApiUrl": "",
  "ApplicationInsights": {
    "ConnectionString": ""
  }
}
