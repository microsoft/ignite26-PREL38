<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>CaldovaLoanPortal</RootNamespace>
    <AssemblyName>CaldovaLoanPortal</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Azure Identity for Managed Identity authentication -->
    <PackageReference Include="Azure.Identity" Version="1.14.0" />
    <!-- Modern SQL client supporting Entra ID Managed Identity -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.0.2" />
    <!-- OpenTelemetry: Azure Monitor distro (includes AspNetCore + Http + Hosting instrumentation) -->
    <PackageReference Include="Azure.Monitor.OpenTelemetry.AspNetCore" Version="1.3.0" />
    <PackageReference Include="OpenTelemetry.Api" Version="1.16.0" />
    <!-- OpenTelemetry: SQL query tracing -->
    <PackageReference Include="OpenTelemetry.Instrumentation.SqlClient" Version="1.16.0" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

  <!-- Exclude the tests sub-project from the main project's compilation -->
  <ItemGroup>
    <Compile Remove="tests/**" />
    <Content Remove="tests/**" />
    <EmbeddedResource Remove="tests/**" />
    <None Remove="tests/**" />
  </ItemGroup>

</Project>