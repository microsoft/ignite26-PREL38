<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Caldova Loan Portal</title>
    <style>
        body {
            margin: 0;
            background: #cfd7e2;
            font-family: Verdana, Arial;
            font-size: 12px;
        }

        a {
            color: #103d73;
            text-decoration: none;
        }

        a:hover {
            text-decoration: underline;
        }
    </style>
</head>
<body>
    <table width="100%" cellpadding="0" cellspacing="0">
        <tr>
            <td style="height: 72px; background: #1e4f8a; color: #fff; padding-left: 18px;
                       background-image: linear-gradient(#3a6ea8, #1e4f8a);">
                <span style="font-size: 24px; font-weight: bold;">Caldova Loan Portal</span>
                <br />
                <span style="font-size: 11px;">Legacy Loan Origination Front Office</span>
            </td>
        </tr>
        <tr>
            <td style="background: #b8c6d8; border-top: 1px solid #8ea7c2;
                       border-bottom: 1px solid #8ea7c2; padding: 6px 10px;">
                <a href="/" style="font-weight: bold; color: #1e4f8a;">&#9664; CaldovaBank Portal</a>&nbsp;|&nbsp;
                <a href="@Url.Action("Index", "Home")">Home</a>&nbsp;|&nbsp;
                @if (User.Identity?.IsAuthenticated != true)
                {
                    <a href="@Url.Action("Login", "Account")">Login</a>
                    <text>&nbsp;|&nbsp;</text>
                }
                <a href="@Url.Action("Logout", "Account")">Logout</a>
                <span style="float: right;">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <span>Signed in: @User.Identity.Name</span>
                    }
                    else
                    {
                        <span>Not signed in</span>
                    }
                </span>
            </td>
        </tr>
        <tr>
            <td>
                @RenderBody()
            </td>
        </tr>
    </table>
</body>
</html>
