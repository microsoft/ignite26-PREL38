{
  "connectors": [
    {
      "name": "azure-mcp",
      "dataConnectorType": "Mcp",
      "dataSource": "npx",
      "extendedProperties": {
        "type": "stdio",
        "command": "npx",
        "args": [
          "-y",
          "@azure/mcp@3.0.0-beta.43",
          "server",
          "start",
          "--mode",
          "single",
          "--namespace",
          "applicationinsights",
          "--namespace",
          "compute",
          "--namespace",
          "containerapps",
          "--namespace",
          "monitor",
          "--namespace",
          "resourcehealth",
          "--namespace",
          "sreagent"
        ],
        "envs": {
          "AZURE_TOKEN_CREDENTIALS": "prod",
          "AZURE_SUBSCRIPTION_ID": "@@SUBSCRIPTION_ID@@",
          "AZURE_CLIENT_ID": "@@AGENT_CLIENT_ID@@",
          "AZURE_TENANT_ID": "@@AGENT_TENANT_ID@@"
        },
        "toolsVisibleToMetaAgent": [
          "azure-mcp_azure"
        ]
      },
      "identity": "@@AGENT_IDENTITY@@"
    },
    {
      "name": "microsoft-learn",
      "type": "http",
      "endpoint": "https://learn.microsoft.com/api/mcp"
    }
  ]
}
