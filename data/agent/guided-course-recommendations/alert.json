{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.39.26.7824",
      "templateHash": "7686119947965646101"
    }
  },
  "parameters": {
    "location": {
      "type": "string"
    },
    "appInsightsId": {
      "type": "string"
    },
    "tags": {
      "type": "object",
      "defaultValue": {}
    },
    "enabled": {
      "type": "bool",
      "defaultValue": false
    }
  },
  "resources": [
    {
      "type": "Microsoft.Insights/scheduledQueryRules",
      "apiVersion": "2023-03-15-preview",
      "name": "Course-recommendations-unavailable",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "properties": {
        "description": "The optional course recommendations experience is unavailable while core learning remains healthy.",
        "severity": 3,
        "enabled": "[parameters('enabled')]",
        "evaluationFrequency": "PT1M",
        "windowSize": "PT5M",
        "scopes": [
          "[parameters('appInsightsId')]"
        ],
        "criteria": {
          "allOf": [
            {
              "query": "customEvents\n| where timestamp > ago(5m)\n| where name == \"CaldovaRecommendationsHealth\"\n| where tostring(customDimensions.featureStatus) == \"degraded\"\n| where tostring(customDimensions.route) == \"/recommendations/health\"\n| summarize AggregatedValue = count()",
              "metricMeasureColumn": "AggregatedValue",
              "timeAggregation": "Total",
              "operator": "GreaterThan",
              "threshold": 0,
              "failingPeriods": {
                "numberOfEvaluationPeriods": 1,
                "minFailingPeriodsToAlert": 1
              }
            }
          ]
        },
        "skipQueryValidation": true,
        "autoMitigate": true,
        "actions": {}
      }
    }
  ],
  "outputs": {
    "alertName": {
      "type": "string",
      "value": "Course-recommendations-unavailable"
    },
    "alertEnabled": {
      "type": "bool",
      "value": "[parameters('enabled')]"
    }
  }
}