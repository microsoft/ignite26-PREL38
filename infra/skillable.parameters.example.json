{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "location": {
      "value": "<supported-region>"
    },
    "postgresLocation": {
      "value": "<supported-postgresql-region>"
    },
    "learnerNumber": {
      "value": 1
    },
    "deploymentToken": {
      "value": "<non-secret-lab-instance-token>"
    },
    "imageRegistrySubscriptionId": {
      "value": "<event-managed-registry-subscription-id>"
    },
    "imageRegistryResourceGroupName": {
      "value": "<event-managed-registry-resource-group>"
    },
    "imageRegistryName": {
      "value": "<event-managed-registry-name>"
    },
    "portalImage": {
      "value": "<event-managed-registry>.azurecr.io/caldova-portal@sha256:<digest>"
    },
    "apiImage": {
      "value": "<event-managed-registry>.azurecr.io/caldova-api@sha256:<digest>"
    },
    "apiLatencyImage": {
      "value": "<event-managed-registry>.azurecr.io/caldova-api-latency@sha256:<digest>"
    },
    "recommendationsMode": {
      "value": "unavailable"
    },
    "postgresAdminPassword": {
      "reference": {
        "keyVault": {
          "id": "<platform-key-vault-resource-id>"
        },
        "secretName": "<deployment-only-postgresql-secret-name>"
      }
    },
    "vmAdminSshPublicKey": {
      "value": "<platform-generated-ssh-public-key>"
    }
  }
}
